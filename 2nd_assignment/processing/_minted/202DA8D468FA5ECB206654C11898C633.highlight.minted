\begin{MintedVerbatim}[commandchars=\\\{\}]
\PYG{c+c1}{\PYGZsh{} 1차: Information Gain으로 동점 후보를 모은다}
\PYG{k}{for} \PYG{n}{attr} \PYG{o+ow}{in} \PYG{n}{attributes}\PYG{p}{:}
    \PYG{n}{ig} \PYG{o}{=} \PYG{n}{information\PYGZus{}gain}\PYG{p}{(}\PYG{n}{data}\PYG{p}{,} \PYG{n}{attr}\PYG{p}{,} \PYG{n}{target}\PYG{p}{)}
    \PYG{k}{if} \PYG{n}{ig} \PYG{o}{\PYGZgt{}} \PYG{n}{best\PYGZus{}gain}\PYG{p}{:}
        \PYG{n}{best\PYGZus{}gain} \PYG{o}{=} \PYG{n}{ig}
        \PYG{n}{candidates} \PYG{o}{=} \PYG{p}{[}\PYG{n}{attr}\PYG{p}{]}
    \PYG{k}{elif} \PYG{n}{ig} \PYG{o}{==} \PYG{n}{best\PYGZus{}gain}\PYG{p}{:}
        \PYG{n}{candidates}\PYG{o}{.}\PYG{n}{append}\PYG{p}{(}\PYG{n}{attr}\PYG{p}{)}

\PYG{c+c1}{\PYGZsh{} 2차: 동점이면 Gain Ratio로 승부}
\PYG{k}{if} \PYG{n+nb}{len}\PYG{p}{(}\PYG{n}{candidates}\PYG{p}{)} \PYG{o}{==} \PYG{l+m+mi}{1}\PYG{p}{:}
    \PYG{k}{return} \PYG{n}{candidates}\PYG{p}{[}\PYG{l+m+mi}{0}\PYG{p}{]}
\PYG{n}{best\PYGZus{}attr} \PYG{o}{=} \PYG{n+nb}{max}\PYG{p}{(}\PYG{n}{candidates}\PYG{p}{,} \PYG{n}{key}\PYG{o}{=}\PYG{k}{lambda} \PYG{n}{attr}\PYG{p}{:} \PYG{n}{gain\PYGZus{}ratio}\PYG{p}{(}\PYG{n}{data}\PYG{p}{,} \PYG{n}{attr}\PYG{p}{,} \PYG{n}{target}\PYG{p}{))}
\end{MintedVerbatim}
