\PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{entropy}\PYG{p}{(}\PYG{n}{data}\PYG{p}{,} \PYG{n}{target}\PYG{p}{):}
    \PYG{n}{labels} \PYG{o}{=} \PYG{p}{[}\PYG{n}{row}\PYG{p}{[}\PYG{n}{target}\PYG{p}{]} \PYG{k}{for} \PYG{n}{row} \PYG{o+ow}{in} \PYG{n}{data}\PYG{p}{]}
    \PYG{n}{counts} \PYG{o}{=} \PYG{n}{Counter}\PYG{p}{(}\PYG{n}{labels}\PYG{p}{)}
    \PYG{n}{total} \PYG{o}{=} \PYG{n+nb}{len}\PYG{p}{(}\PYG{n}{data}\PYG{p}{)}
    \PYG{n}{h} \PYG{o}{=} \PYG{l+m+mf}{0.0}
    \PYG{k}{for} \PYG{n}{count} \PYG{o+ow}{in} \PYG{n}{counts}\PYG{o}{.}\PYG{n}{values}\PYG{p}{():}
        \PYG{n}{p} \PYG{o}{=} \PYG{n}{count} \PYG{o}{/} \PYG{n}{total}
        \PYG{k}{if} \PYG{n}{p} \PYG{o}{\PYGZgt{}} \PYG{l+m+mi}{0}\PYG{p}{:}
            \PYG{n}{h} \PYG{o}{\PYGZhy{}=} \PYG{n}{p} \PYG{o}{*} \PYG{n}{math}\PYG{o}{.}\PYG{n}{log2}\PYG{p}{(}\PYG{n}{p}\PYG{p}{)}
    \PYG{k}{return} \PYG{n}{h}
\end{MintedVerbatim}
